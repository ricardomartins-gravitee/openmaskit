#!/bin/sh
set -eu
launcher=$0
while [ -L "$launcher" ]; do
    link=$(readlink "$launcher")
    case "$link" in
        /*) launcher=$link ;;
        *) launcher=$(dirname -- "$launcher")/$link ;;
    esac
done
fork_root=$(CDPATH= cd -- "$(dirname -- "$launcher")/.." && pwd)
exec "$fork_root/.venv/bin/python" "$fork_root/scripts/start.py" "$@"
